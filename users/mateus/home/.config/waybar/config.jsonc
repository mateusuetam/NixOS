{
"modules-left": [
"sway/workspaces",
"niri/workspaces",
"mpris"
],

"modules-right": [
"tray",
"idle_inhibitor",
"custom/cliphist",
"bluetooth",
"network",
"wireplumber#source",
"wireplumber#sink",
"backlight",
"battery",
"clock"
],

"sway/workspaces": {
"format": "{index}",
"interval": "once"
},

"niri/workspaces": {
"format": "{index}",
"interval": "once"
},

"mpris": {
"format": "{status_icon} {artist} - {title}",
"format-paused": "{status_icon} {artist} - {title}",
"status-icons": {
"paused": "󰐊",
"playing": "󰏤",
"stopped": "󰓛"
},
"max-length": 100,
"tooltip": false,
"interval": "once"
},

"tray": {
"icon-size": 14,
"spacing": 20,
"show-passive-items": true,
"interval": "once"
},

"idle_inhibitor": {
"format": "{icon}",
"format-icons": {
"activated": "󰅶",
"deactivated": "󰾪"
},
"timeout": 720,
"tooltip": false,
"interval": "once"
},

"custom/cliphist": {
"format": "󱛢",
"on-click": "foot -e sh -c 'cliphist list; printf \"\\nPressione ENTER para fechar...\"; read'",
"on-click-right": "cliphist wipe && notify-send 'Cliphist' 'Histórico limpo!'",
"tooltip": false,
"interval": "once"
},

"bluetooth": {
"format-on": "󰂯",
"format-off": "󰂲",
"format-disabled": "󰂲",
"format-connected": "󰂰",
"on-click": "foot -e bluetoothctl",
"on-click-right": "rfkill toggle bluetooth",
"tooltip-format": "{device_alias} ({device_battery_percentage}%)",
"interval": 60
},

"network": {
"format-wifi": "󰤥",
"format-ethernet": "󰈁",
"format-disconnected": "󰤠",
"format-disabled": "󰤭",
"on-click": "foot -e sh -c 'nmcli device show; printf \"\\nPressione ENTER para fechar...\"; read'",
"on-click-right": "rfkill toggle wlan",
"tooltip-format": "{essid}",
"interval": "once"
},

"wireplumber#source": {
"node-type": "Audio/Source",
"format": " {volume}%",
"format-muted": "",
"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 1%+",
"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
"tooltip-format": "{node_name}",
"interval": "once"
},

"wireplumber#sink": {
"node-type": "Audio/Sink",
"format": "{icon} {volume}%",
"format-muted": "",
"format-icons": ["","","",""],
"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+",
"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
"tooltip-format": "{node_name}",
"interval": "once"
},

"backlight": {
"format": "{icon} {percent}%",
"format-icons": ["󰛩","󱩎","󱩏","󱩐","󱩑","󱩒","󱩓","󱩔","󱩕","󱩖","󰛨"],
"on-click": "gammastep -O 2000",
"on-click-right": "pkill gammastep",
"tooltip": false,
"interval": "once"
},

"battery": {
"states": {
"good": 80,
"warning": 29,
"critical": 19
},
"format": "{icon} {capacity}%",
"format-full": "󰂄 {capacity}%",
"format-charging": "󰂄 {capacity}%",
"format-plugged": "󰂄 {capacity}%",
"format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
"tooltip": false,
"interval": 60
},

"clock": {
"format": "{:%H:%M}",
"format-alt": "{:L%A, %e de %b - %H:%M}",
"locale": "pt_BR.UTF-8",
"tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
"calendar": {
"mode": "month",
"mode-mon-col": 1,
"weeks-pos": "right",
"on-scroll": 1,
"format": {
"weekdays": "<span color='#629386'><b>{}</b></span>",
"today": "<span color='#989F56'><b><u>{}</u></b></span>",
"days": "<span color='#F4E6D2'><b>{}</b></span>",
"weeks": "<span color='#E46A3A'><b>W{}</b></span>",
"months": "<span color='#517894'><b>{}</b></span>"
}
},
"interval": 60
}
}
