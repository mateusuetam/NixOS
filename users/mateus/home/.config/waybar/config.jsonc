{
"modules-left": [
"sway/workspaces",
"custom/arrow_workspaces_mpris",
"mpris",
"custom/arrow_mpris_bg"
],

"modules-center": [
"sway/window"
],

"modules-right": [
"custom/arrow_bg_tray",
"tray",
"idle_inhibitor",
"custom/arrow_idle_cliphist",
"custom/cliphist",
"bluetooth",
"custom/arrow_bluetooth_network",
"network",
"wireplumber#source",
"wireplumber#sink",
"custom/arrow_wireplumber_backlight",
"backlight",
"battery",
"custom/arrow_battery_clock",
"clock",
"custom/arrow_clock_menu",
"custom/menu"
],

"sway/workspaces": {
"all-outputs": true,
"format": "{name}",
"interval": "once"
},

"mpris": {
"format": "{status_icon} {artist} - {title}",
"format-paused": "{status_icon} {artist} - {title}",
"status-icons": {
"paused": "󰐊",
"playing": "󰏤",
"stopped": "󰓛"
},
"max-length": 40,
"tooltip": false,
"interval": "once"
},

"sway/window": {
"format": "{}",
"max-length": 40,
"interval": "once"
},

"tray": {
"icon-size": 18,
"spacing": 15,
"show-passive-items": true,
"interval": "once"
},

"idle_inhibitor": {
"format": "{icon}",
"format-icons": {
"activated": "󰅶",
"deactivated": "󰾪"
},
"timeout": 720,
"tooltip": false,
"interval": "once"
},

"custom/cliphist": {
"format": "󰆏",
"tooltip": false,
"on-click": "cliphist list | rofi -dmenu -theme $HOME/.config/rofi/launcher.rasi | cliphist decode | wl-copy",
"on-click-right": "cliphist wipe && notify-send 'Cliphist' 'Histórico limpo!'",
"interval": "once"
},

"bluetooth": {
"format": "󰂲",
"format-on": "{icon}",
"format-off": "{icon}",
"format-connected": "{icon}",
"format-connected-battery": "󰂱 ({device_battery_percentage}%)",
"format-icons": {
"on": "󰂯",
"off": "󰂲",
"connected": "󰂱"
},
"on-click": "$HOME/.scripts/blue.sh",
"on-click-right": "rfkill toggle bluetooth",
"tooltip-format": "{device_alias}",
"interval": 60
},

"network": {
"format-wifi": "󰤢",
"format-ethernet": "󰈀",
"format-disconnected": "󰤠",
"format-disabled": "󰤭",
"tooltip-format": "{essid}",
"on-click": "$HOME/.scripts/wifi.sh",
"on-click-right": "rfkill toggle wlan",
"interval": "once"
},

"wireplumber#source": {
"node-type": "Audio/Source",
"format": " {volume}%",
"format-muted": "",
"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 1%+",
"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
"interval": "once"
},

"wireplumber#sink": {
"node-type": "Audio/Sink",
"format": "{icon}  {volume}%",
"format-muted": "",
"format-icons": ["","",""],
"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+",
"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
"interval": "once"
},

"backlight": {
"format": "{icon}  {percent}%",
"format-icons": ["","󰃜","󰃛","󰃞","󰃝","󰃟","󰃠"],
"tooltip": false,
"on-click": "$HOME/.scripts/redfilter.sh",
"on-click-right": "pkill gammastep || gammastep -O 2500",
"interval": "once"
},

"battery": {
"states": {
"good": 80,
"warning": 29,
"critical": 19
},
"format": "{icon}  {capacity}%",
"format-full": " {icon}  {capacity}%",
"format-charging": " {capacity}%",
"format-plugged": " {capacity}%",
"format-icons": ["","","","",""],
"tooltip": false,
"interval": 60
},

"clock": {
"format": "{:%H:%M}",
"format-alt": "{:L%A, %e de %b - %H:%M}",
"locale": "pt_BR.UTF-8",
"tooltip": true,
"tooltip-format": "<tt><span size='11pt'>{calendar}</span></tt>",
"calendar": {
"mode": "month",
"mode-mon-col": 1,
"weeks-pos": "right",
"on-scroll": 1,
"format": {
"months": "<span color='#ff6699'><b>{}</b></span>",
"days": "<span color='#2ecc71'><b>{}</b></span>",
"weeks": "<span color='#9b59b6'><b>W{}</b></span>",
"weekdays": "<span color='#f1c40f'><b>{}</b></span>",
"today": "<span color='#e74c3c'><b><u>{}</u></b></span>"
}
},
"interval": 60
},

"custom/menu": {
"format": "⏻",
"tooltip": false,
"on-click": "$HOME/.scripts/powermenu.sh",
"interval": "once"
},

"custom/arrow_workspaces_mpris": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_mpris_bg": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_bg_tray": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_idle_cliphist": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_bluetooth_network": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_wireplumber_backlight": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_battery_clock": { "format": "", "tooltip": false, "interval": "once" },
"custom/arrow_clock_menu": { "format": "", "tooltip": false, "interval": "once" }
}
